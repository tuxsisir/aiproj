DEBUG=True
# Password for the local dev accounts (manage.py seed_dev_accounts); never used in production
DEV_ACCOUNT_PASSWORD=
SECRET_KEY=replace-me-with-a-secure-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost
# Production only (see docs/DEPLOY.md): CSRF_TRUSTED_ORIGINS=https://usecivicdesk.com
# MEDIA_ROOT=/var/data/media   (uploads on a persistent disk; defaults to ./media)

# Database (PostgreSQL)
# e.g. postgres://user:password@localhost:5432/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stratacorp

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_SECRET=your-google-client-secret

# Stripe Keys
STRIPE_PUBLIC_KEY=your_stripe_public_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Claude API (document summaries and Q&A)
ANTHROPIC_API_KEY=

# Resend Email Configuration
RESEND_API_KEY="re_xxxxxx"
DEFAULT_FROM_EMAIL="CivicDesk <noreply@usecivicdesk.com>"
EMAIL_REPLY_TO=
SITE_URL=http://127.0.0.1:8000

# Inbound email (forward building emails to CivicDesk for AI summaries)
# Domain with Resend receiving enabled (MX records point to Resend):
INBOUND_EMAIL_DOMAIN=inbox.usecivicdesk.com
# Signing secret of the Resend "email.received" webhook -> https://<SITE_URL>/anymail/resend/inbound/
RESEND_INBOUND_SECRET=

